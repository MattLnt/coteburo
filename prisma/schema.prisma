generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marque {
  id         String      @id @default(cuid())
  nom        String      @unique
  slug       String      @unique
  remise     Float       @default(0)
  actif      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  logoUrl    String?
  categories Categorie[]
  gammes     Gamme[]
  produits   Produit[]
}

model Categorie {
  id             String           @id @default(cuid())
  nom            String
  slug           String
  ordre          Int              @default(0)
  marqueId       String
  createdAt      DateTime         @default(now())
  margePct       Float?
  icone          String?
  estOption      Boolean          @default(false)
  marque         Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  sousCategories SousCategorie[]
  gammes         Gamme[]          @relation("GammeCategories")
  vitrines       ProduitVitrine[] @relation("VitrineCategories")

  @@unique([marqueId, slug])
  @@index([marqueId])
}

model Gamme {
  id              String           @id @default(cuid())
  nom             String
  slug            String           @unique
  descriptif      String?
  descriptionTech String?
  imageUrl        String?
  images          String[]         @default([])
  marqueId        String
  publie          Boolean          @default(false)
  bestSeller      Boolean          @default(false)
  enAvant         Boolean          @default(false)
  ordre           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  venteSurDevis   Boolean          @default(false)
  marque          Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  groupesFinition GroupeFinition[]
  produits        Produit[]
  vitrines        ProduitVitrine[]
  categories      Categorie[]      @relation("GammeCategories")

  @@index([marqueId])
}

model GroupeFinition {
  id        String          @id @default(cuid())
  nom       String
  ordre     Int             @default(0)
  gammeId   String?
  vitrineId String?
  finitions Finition[]
  gamme     Gamme?          @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  vitrine   ProduitVitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@index([gammeId])
  @@index([vitrineId])
}

model Finition {
  id          String         @id @default(cuid())
  nom         String
  imageUrl    String?
  couleur     String?
  paletteNom  String?
  ordre       Int            @default(0)
  groupeId    String
  groupe   GroupeFinition @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([groupeId])
}

model Produit {
  codeRacine             String          @id
  marqueId               String
  gamme                  String
  designation            String
  slug                   String?         @unique
  descriptionWeb         String?
  categorie              String?
  imageUrl               String?
  prixPublicHT           Float
  prixVenteHT            Float?
  prixVarieSelonFinition Boolean         @default(false)
  prixVerrouille         Boolean         @default(false)
  publie                 Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  prixAchatHT            Float?
  images                 String[]        @default([])
  bestSeller             Boolean         @default(false)
  enAvant                Boolean         @default(false)
  sousCategorie          String?
  gammeId                String?
  vitrineId              String?
  hauteur                Int?
  longueur               Int?
  options                String[]        @default([])
  pied                   String?
  plateau                String?
  profondeur             String?
  gammeRef               Gamme?          @relation(fields: [gammeId], references: [id])
  marque                 Marque          @relation(fields: [marqueId], references: [id])
  vitrine                ProduitVitrine? @relation(fields: [vitrineId], references: [id])
  variantes              Variante[]

  @@index([marqueId])
  @@index([gammeId])
  @@index([categorie])
  @@index([sousCategorie])
  @@index([hauteur])
  @@index([longueur])
  @@index([vitrineId])
}

model Variante {
  codeArticle     String  @id
  codeRacine      String
  finition        String?
  ean             String?
  poids           Float?
  prixPublicHT    Float
  ecoContribution Float   @default(0)
  prixVenteHT     Float?
  prixVerrouille  Boolean @default(false)
  prixAchatHT     Float?
  produit         Produit @relation(fields: [codeRacine], references: [codeRacine], onDelete: Cascade)

  @@index([codeRacine])
}

model Reglages {
  id                     Int      @id @default(1)
  tva                    Float    @default(0.20)
  remiseGlobale          Float    @default(0.20)
  updatedAt              DateTime @updatedAt
  adresse                String?
  bandeauActif           Boolean  @default(false)
  bandeauTexte           String?
  // Bandeau PROMOTIONNEL, distinct du bandeau ci-dessus qui porte l adresse
  // et le telephone. Il annonce une campagne en cours et disparait avec elle.
  bandeauPromoActif      Boolean  @default(false)
  bandeauPromoTexte      String?
  delaiLivraison         String?
  email                  String?
  facebook               String?
  francoPort             Float?
  horaires               String?
  instagram              String?
  linkedin               String?
  telephone              String?
  zoneLivraison          String?
  margeGlobale           Float    @default(0.30)
  seuilLivraisonGratuite Float    @default(500)
  fraisLivraison         Float    @default(59)
  validiteDevisJours     Int      @default(30)
}

model PalierInstallation {
  id        String   @id @default(cuid())
  seuilMax  Float
  prix      Float
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model Realisation {
  id             String           @id @default(cuid())
  titre          String
  client         String?
  secteur        String?
  surface        String?
  imageUrl       String?
  slug           String           @unique
  publie         Boolean          @default(false)
  ordre          Int              @default(0)
  createdAt      DateTime         @default(now())
  recit          String?
  citationTexte  String?
  citationAuteur String?
  citationPoste  String?
  galerie        String[]         @default([])
  avantImageUrl  String?
  apresImageUrl  String?
  carnetChantier Json?
  produitsLies   ProduitVitrine[] @relation("RealisationProduits")
}

model Article {
  id        String   @id @default(cuid())
  titre     String
  slug      String   @unique
  extrait   String?
  contenu   String   @default("")
  imageUrl  String?
  categorie String?
  auteur    String?
  publie    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publie])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Promotion {
  id         String             @id @default(cuid())
  nom        String
  typeRemise String             @default("pourcentage")
  valeur     Float
  dateDebut  DateTime?
  dateFin    DateTime?
  actif      Boolean            @default(true)
  // Message affiché dans le bandeau du site. Rédigé avec la campagne : c'est
  // elle qui sait ce qu'elle annonce, pas les réglages généraux.
  messageBandeau String?
  categories String[]           @default([])
  createdAt  DateTime           @default(now())
  produits   PromotionProduit[]
  vitrines   PromotionVitrine[]
}

// Ancien ciblage, par codeRacine du modèle Produit — table vide depuis la
// migration vers ProduitVitrine. Conservée le temps de vérifier que plus rien
// ne s'y réfère ; remplacée par PromotionVitrine.
model PromotionProduit {
  promotionId String
  codeRacine  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, codeRacine])
  @@index([codeRacine])
}

// Ciblage d'une campagne sur des fiches précises. Une campagne peut aussi
// viser des catégories entières, via Promotion.categories.
model PromotionVitrine {
  promotionId String
  vitrineId   String
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  vitrine     ProduitVitrine @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@id([promotionId, vitrineId])
  @@index([vitrineId])
}

model Commande {
  id                String          @id @default(cuid())
  numero            String          @unique
  statut            String          @default("en_attente")
  email             String
  telephone         String?
  prenom            String
  nom               String
  societe           String?
  adresse           String
  complement        String?
  codePostal        String
  ville             String
  pays              String          @default("France")
  totalHT           Float
  totalTVA          Float
  totalTTC          Float
  // Somme des éco-contributions des lignes, affichée distinctement sur
  // la facture comme la loi l'impose.
  totalEcoPart      Float           @default(0)
  fraisLivraison    Float           @default(0)
  fraisInstallation Float           @default(0)
  avecInstallation  Boolean         @default(false)
  stripeSessionId   String?
  stripePaymentId   String?
  paye              Boolean         @default(false)
  userId            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lignes            LigneCommande[]
  devis             Devis?

  @@index([email])
  @@index([statut])
}

model LigneCommande {
  id                   String   @id @default(cuid())
  commandeId           String
  codeRacine           String?
  designation          String
  marque               String?
  finition             String?
  prixHT               Float
  quantite             Int
  imageUrl             String?
  referenceFournisseur String?
  // Éco-contribution unitaire, reprise du tarif fournisseur. La loi
  // impose qu'elle figure distinctement sur la facture, sans marge :
  // Côté BURO la paie au fabricant et la refacture à l'identique.
  ecoContribution      Float    @default(0)

  // ── Identité de ce qui est commandé ────────────────────────────────
  // Figée à la commande, comme le reste de la ligne : une commande ne doit
  // jamais changer parce que le catalogue a changé. Mais elle doit dire
  // exactement QUOI commander, et chez qui.
  //
  // La fiche d'origine, pour remonter — service après-vente, recommande,
  // statistique par gamme. Sans clé étrangère : la fiche peut disparaître
  // du catalogue sans emporter l'historique.
  vitrineId            String?
  combinaisonId        String?
  // La référence assemblée par la règle du modèle :
  // referenceBase + Σ suffixeReference. « BX865F », pas « d13pufsd ».
  // Une ligne de catalogue sans cette référence ne peut pas être commandée.
  referenceComplete    String?
  fournisseur          String?
  // Les choix retenus, structurés — « finition » ci-dessus n'en est que la
  // version lisible. Permet de reconstituer, de chercher et de compter :
  // combien de plateaux Nebraska vendus ce trimestre.
  choix                Json?
  // Une option se rattache au produit qu'elle complète, au lieu de flotter
  // à côté de lui sur le bon de commande.
  ligneParenteId       String?

  commande             Commande        @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  ligneParente         LigneCommande?  @relation("OptionDeLigne", fields: [ligneParenteId], references: [id], onDelete: SetNull)
  options              LigneCommande[] @relation("OptionDeLigne")

  @@index([commandeId])
  @@index([vitrineId])
  @@index([ligneParenteId])
}

// ─────────────────────────────────────────────────────────────
// Devis — cycle complet : demande client → chiffrage admin →
// envoi → acceptation → paiement (devient une Commande).
//
// statut : nouveau | en_cours | envoye | accepte | refuse | expire
// ─────────────────────────────────────────────────────────────
model Devis {
  id        String   @id @default(cuid())
  numero    String   @unique
  statut    String   @default("nouveau")
  // Jeton du lien unique envoyé au client (accès sans compte)
  token     String   @unique

  // Coordonnées saisies dans le formulaire
  prenom    String
  nom       String
  societe   String?
  email     String
  telephone String?

  // Description du projet
  typeProjet String?
  surface    String?
  delai      String?
  budget     String?
  message    String?

  // Adresse de livraison — renseignée au chiffrage, pas au formulaire
  adresse    String?
  complement String?
  codePostal String?
  ville      String?
  pays       String  @default("France")

  // Montants — calculés au chiffrage, nuls tant que le devis n'est pas chiffré
  totalHT           Float?
  totalTVA          Float?
  totalTTC          Float?
  // Somme des éco-contributions des lignes. Stockée à part pour
  // l'afficher sur le document sans avoir à la recalculer.
  totalEcoPart      Float   @default(0)
  fraisLivraison    Float   @default(0)
  fraisInstallation Float   @default(0)
  // Remise globale : "pourcentage" ou "montant" — remiseValeur s'interprète
  // selon ce type (5 = 5 % ou 5 €).
  remiseType        String  @default("pourcentage")
  remiseValeur      Float   @default(0)

  // Mot d'accompagnement affiché sur le devis envoyé au client
  noteClient String?
  // Note interne, jamais visible par le client
  noteInterne String?

  // Suivi
  dateEnvoi     DateTime?
  dateValidite  DateTime?
  dateReponse   DateTime?
  userId        String?

  // Commande générée à l'acceptation
  commandeId String?   @unique
  commande   Commande? @relation(fields: [commandeId], references: [id])

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  lignes    LigneDevis[]

  @@index([email])
  @@index([statut])
  @@index([token])
}

model LigneDevis {
  id          String  @id @default(cuid())
  devisId     String
  // Référence au catalogue si la ligne vient d'un produit ; nulle pour une
  // ligne libre ajoutée à la main (prestation, transport, remise…)
  codeRacine  String?
  vitrineId   String?
  designation String
  marque      String?
  gammeNom    String?
  config      String?
  imageUrl    String?
  prixHT      Float   @default(0)
  quantite    Int     @default(1)
  // Éco-contribution unitaire, reprise du tarif fournisseur. Elle ne
  // subit pas la marge — c'est une taxe refacturée telle quelle — et
  // doit apparaître distinctement sur le document.
  ecoContribution Float @default(0)
  ordre       Int     @default(0)

  // Même bloc d'identité que sur la commande : le devis doit déjà savoir
  // quoi commander, sans quoi l'information est à retrouver au moment de
  // l'acceptation — et c'est là qu'elle se perdait.
  combinaisonId     String?
  referenceComplete String?
  fournisseur       String?
  choix             Json?
  ligneParenteId    String?

  devis        Devis        @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ligneParente LigneDevis?  @relation("OptionDeLigneDevis", fields: [ligneParenteId], references: [id], onDelete: SetNull)
  options      LigneDevis[] @relation("OptionDeLigneDevis")

  @@index([devisId])
  @@index([vitrineId])
  @@index([ligneParenteId])
}

model Favori {
  id         String          @id @default(cuid())
  userId     String
  codeRacine String?
  vitrineId  String?
  createdAt  DateTime        @default(now())
  vitrine    ProduitVitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@unique([userId, codeRacine])
  @@unique([userId, vitrineId])
  @@index([userId])
}

model ProduitVitrine {
  id                        String           @id @default(cuid())
  nom                       String
  slug                      String
  descriptif                String?
  imageUrl                  String?
  images                    String[]         @default([])
  ordre                     Int              @default(0)
  publie                    Boolean          @default(true)
  gammeId                   String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  venteSurDevis             Boolean          @default(true)
  bestSeller                Boolean          @default(false)
  // Mise en avant dans la section « Notre sélection » de la page d'accueil,
  // indépendante de bestSeller qui alimente le carrousel Best-sellers.
  enAvant                   Boolean          @default(false)
  promoPct                  Float?
  promoDebut                DateTime?
  promoFin                  DateTime?
  prixAPartir               Float?
  largeurMin                Int?
  largeurMax                Int?
  hauteurMin                Int?
  hauteurMax                Int?
  profondeurMin             Int?
  profondeurMax             Int?
  sansDeclinaisons          Boolean          @default(false)
  // Vendu uniquement comme accessoire : la fiche sort des listes du
  // catalogue et de la recherche, mais reste joignable par son adresse — un
  // lien de devis ou de commande ne doit pas mourir — et reste proposée sur
  // les fiches des produits qui la citent en option.
  //
  // Le réglage par catégorie (« Accessoires », estOption) ne suffisait pas :
  // soixante-quatorze fiches sont option d'un produit, et cinquante-quatre
  // d'entre elles vivent dans des rayons ordinaires — un voile de fond est
  // rangé dans Bureaux. On ne va pas l'en sortir pour le masquer.
  accessoireSeul           Boolean          @default(false)
  prixUnitaireTarifHT       Float?
  prixUnitaireHT            Float?
  prixUnitaireVerrouille    Boolean          @default(false)
  referenceUnitaire         String?
  optionsAdditionnelles     Json?
  sectionsDevis             Json?
  optionsInformatives       Json?
  axesDeclinaisons          Json?
  declinaisons              Json?
  categoriePrincipaleId     String?
  sousCategoriePrincipaleId String?
  groupesFinition           GroupeFinition[]
  choix                     Choix[]
  combinaisons              Combinaison[]
  visuels                   Visuel[]
  exclusionsFinition        ExclusionFinition[]
  produits                  Produit[]
  favoris                   Favori[]
  realisations              Realisation[]    @relation("RealisationProduits")
  gamme                     Gamme            @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  categories                Categorie[]      @relation("VitrineCategories")
  sousCategories            SousCategorie[]  @relation("VitrineSousCategories")
  promotions                PromotionVitrine[]
  optionsLiees              ProduitVitrine[] @relation("ProduitOptions")
  optionPour                ProduitVitrine[] @relation("ProduitOptions")
  // Produits suggeres sur la fiche (bloc « Vous aimerez aussi »). Distincts
  // des optionsLiees, qui sont des accessoires vendus AVEC le produit.
  produitsLies              ProduitVitrine[] @relation("ProduitsLies")
  liePour                   ProduitVitrine[] @relation("ProduitsLies")

  @@unique([gammeId, slug])
  @@index([gammeId])
  @@index([largeurMin])
  @@index([hauteurMin])
  @@index([profondeurMin])
}

model SousCategorie {
  id          String           @id
  nom         String
  slug        String
  ordre       Int              @default(0)
  categorieId String
  createdAt   DateTime         @default(now())
  categorie   Categorie        @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  vitrines    ProduitVitrine[] @relation("VitrineSousCategories")

  @@unique([categorieId, slug])
  @@index([categorieId])
}

// ─────────────────────────────────────────────────────────────
// Bibliothèque de finitions partagée (référentiel réutilisable)
// PaletteFinition = un regroupement (ex. "Palette bois Buronomic")
// FinitionModele  = une finition définie une seule fois (couleur + swatch)
// ─────────────────────────────────────────────────────────────
model PaletteFinition {
  id        String           @id @default(cuid())
  nom       String
  marque    String?
  ordre     Int              @default(0)
  createdAt DateTime         @default(now())
  finitions FinitionModele[]
  valeurs   ValeurChoix[]
}

model FinitionModele {
  id        String           @id @default(cuid())
  nom       String
  couleur   String?
  imageUrl  String?
  ordre     Int              @default(0)
  paletteId String?
  palette   PaletteFinition? @relation(fields: [paletteId], references: [id], onDelete: SetNull)
  valeurs   ValeurChoix[]
  createdAt DateTime         @default(now())

  @@index([paletteId])
}

// ─────────────────────────────────────────────────────────────
// Le modèle produit à choix, valeurs, combinaisons et visuels
//
// Documenté dans docs/modele-produit.md. Trois natures de variation y sont
// distinguées, là où les anciens champs JSON les confondaient :
//
//   tarifaire  change le prix ET la référence   → entre dans la matrice
//   finition   change la référence SEULE        → n'y entre pas
//   option     s'ajoute au panier               → article à part
//
// La référence commandée s'assemble :
//   Combinaison.referenceBase + Σ ValeurChoix.suffixeReference
//   « BX86 » + « 1 » (piétement aluminium) + « A » (plateau hêtre) = BX861A
//
// Ces modèles vivent à côté de axesDeclinaisons / declinaisons / GroupeFinition
// le temps de la bascule : rien n'est supprimé tant que le front n'a pas migré.
// ─────────────────────────────────────────────────────────────

enum NatureChoix {
  tarifaire
  finition
  option
}

enum RenduChoix {
  boutons
  pastilles
  nuancier
  liste
  vignettes
  cases
}

enum RoleVisuel {
  vignette
  galerie
  ambiance
  schema
}

// D'où vient une donnée, et donc qui a le droit de l'écraser. Le réimport du
// tarif ne touche jamais ce qui est marqué « editorial ».
enum OrigineDonnee {
  tarif
  editorial
}

model Choix {
  id          String         @id @default(cuid())
  // Clé stable, employée dans Combinaison.valeurs : « largeur », « plateau ».
  cle         String
  nom         String
  nature      NatureChoix
  rendu       RenduChoix     @default(boutons)
  ordre       Int            @default(0)
  // Le rang de ce choix dans l'assemblage de la référence commandée, qui
  // n'est PAS son ordre d'affichage. Chez Eko la fiche montre la serrure
  // avant la finition, mais la référence écrit DZ51 + finition + serrure.
  // Sans ce rang, la référence ne peut pas se reconstruire — et c'est tout
  // l'objet du modèle. Vide = ce choix n'ajoute rien à la référence.
  rangReference Int?
  obligatoire Boolean        @default(true)
  origine     OrigineDonnee  @default(tarif)
  vitrineId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vitrine     ProduitVitrine @relation(fields: [vitrineId], references: [id], onDelete: Cascade)
  valeurs     ValeurChoix[]

  @@unique([vitrineId, cle])
  @@index([vitrineId])
}

model ValeurChoix {
  id               String           @id @default(cuid())
  libelle          String
  couleur          String?
  imageUrl         String?
  // Ce qui s'ajoute à la référence de base quand cette valeur est retenue.
  suffixeReference String?
  // Presque toujours vide : le prix vient de la combinaison. Ne sert qu'aux
  // fournisseurs qui facturent explicitement un supplément de finition.
  supplementHT     Float?
  ordre            Int              @default(0)
  choixId          String
  paletteId        String?
  // Le lien vers la bibliothèque, par une CLÉ et non par un nom. La couleur
  // et la pastille s'héritent du modèle ; les champs ci-dessus ne servent
  // qu'à surcharger ce qui diffère vraiment.
  //
  // Le lien par le texte — « paletteNom » — a lâché deux fois en une
  // semaine : il valait null sur les 2 135 finitions au moment d'écrire
  // ceci, emporté par des groupes refaits. Une clé étrangère ne se rompt pas.
  modeleId         String?
  choix            Choix            @relation(fields: [choixId], references: [id], onDelete: Cascade)
  palette          PaletteFinition? @relation(fields: [paletteId], references: [id], onDelete: SetNull)
  modele           FinitionModele?  @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  visuels          VisuelValeur[]

  @@unique([choixId, libelle])
  @@index([choixId])
  @@index([paletteId])
  @@index([modeleId])
}

model Combinaison {
  id              String         @id @default(cuid())
  // { largeur: "120 cm", profondeur: "143 cm" } — clés = Choix.cle tarifaires.
  valeurs         Json
  // Empreinte stable des valeurs : garantit l'unicité sans dépendre de
  // l'ordre des clés du JSON.
  empreinte       String
  prixTarifHT     Float?
  ecoContribution Float?
  poids           Float?
  ean             String?
  referenceBase   String?
  pageCatalogue   Int?
  // L'identifiant de l'ancienne déclinaison, cité par les devis et les
  // paniers déjà enregistrés. Conservé pour que rien ne se perde à la bascule.
  ancienId        String?
  vitrineId       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  vitrine         ProduitVitrine @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@unique([vitrineId, empreinte])
  @@index([vitrineId])
  @@index([ancienId])
}

model Visuel {
  id        String         @id @default(cuid())
  url       String
  role      RoleVisuel     @default(galerie)
  ordre     Int            @default(0)
  // Le recadrage se lit dans la donnée, plus dans le nom du fichier : un
  // second passage ne peut pas recadrer deux fois, et l'original reste là,
  // donc l'opération se défait.
  recadre   Boolean        @default(false)
  urlOrigine String?
  vitrineId String
  createdAt DateTime       @default(now())
  vitrine   ProduitVitrine @relation(fields: [vitrineId], references: [id], onDelete: Cascade)
  // Un visuel illustre souvent PLUSIEURS valeurs à la fois : une photo montre
  // un piétement ET un plateau. Un champ unique obligeait à choisir, et
  // choisissait mal une fois sur deux.
  valeurs   VisuelValeur[]

  @@index([vitrineId])
}

// Le rattachement d'un visuel aux valeurs qu'il montre. Le front n'affiche
// le visuel que lorsque TOUTES ses valeurs sont retenues par le client.
model VisuelValeur {
  visuelId      String
  valeurChoixId String
  visuel        Visuel      @relation(fields: [visuelId], references: [id], onDelete: Cascade)
  valeurChoix   ValeurChoix @relation(fields: [valeurChoixId], references: [id], onDelete: Cascade)

  @@id([visuelId, valeurChoixId])
  @@index([valeurChoixId])
}

// Les associations de finitions que le tarif ne vend pas. La règle de
// référence reste exacte ; c'est la disponibilité qui n'est pas le produit
// cartésien complet — les comptoirs Fifty Full n'acceptent pas Yukon sur
// Nebraska. Quatre cent vingt-neuf associations sur trente-deux fiches.
model ExclusionFinition {
  id        String         @id @default(cuid())
  // Les identifiants de ValeurChoix qui, ensemble, n'existent pas.
  valeurs   Json
  vitrineId String
  vitrine   ProduitVitrine @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@index([vitrineId])
}

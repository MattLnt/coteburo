generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marque {
  id         String      @id @default(cuid())
  nom        String      @unique
  slug       String      @unique
  remise     Float       @default(0)
  actif      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  logoUrl    String?
  categories Categorie[]
  gammes     Gamme[]
  produits   Produit[]
}

model Categorie {
  id             String           @id @default(cuid())
  nom            String
  slug           String
  ordre          Int              @default(0)
  marqueId       String
  createdAt      DateTime         @default(now())
  margePct       Float?
  marque         Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  sousCategories SousCategorie[]
  gammes         Gamme[]          @relation("GammeCategories")
  vitrines       ProduitVitrine[] @relation("VitrineCategories")

  @@unique([marqueId, slug])
  @@index([marqueId])
}

model Gamme {
  id              String           @id @default(cuid())
  nom             String
  slug            String           @unique
  descriptif      String?
  descriptionTech String?
  imageUrl        String?
  images          String[]         @default([])
  marqueId        String
  publie          Boolean          @default(false)
  bestSeller      Boolean          @default(false)
  enAvant         Boolean          @default(false)
  ordre           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  venteSurDevis   Boolean          @default(false)
  marque          Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  groupesFinition GroupeFinition[]
  produits        Produit[]
  vitrines        ProduitVitrine[]
  categories      Categorie[]      @relation("GammeCategories")

  @@index([marqueId])
}

model GroupeFinition {
  id        String          @id @default(cuid())
  nom       String
  ordre     Int             @default(0)
  gammeId   String?
  vitrineId String?
  finitions Finition[]
  gamme     Gamme?          @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  vitrine   ProduitVitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@index([gammeId])
  @@index([vitrineId])
}

model Finition {
  id       String         @id @default(cuid())
  nom      String
  imageUrl String?
  couleur  String?
  ordre    Int            @default(0)
  groupeId String
  groupe   GroupeFinition @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([groupeId])
}

model Produit {
  codeRacine             String          @id
  marqueId               String
  gamme                  String
  designation            String
  slug                   String?         @unique
  descriptionWeb         String?
  categorie              String?
  imageUrl               String?
  prixPublicHT           Float
  prixVenteHT            Float?
  prixVarieSelonFinition Boolean         @default(false)
  prixVerrouille         Boolean         @default(false)
  publie                 Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  prixAchatHT            Float?
  images                 String[]        @default([])
  bestSeller             Boolean         @default(false)
  enAvant                Boolean         @default(false)
  sousCategorie          String?
  gammeId                String?
  vitrineId              String?
  hauteur                Int?
  longueur               Int?
  options                String[]        @default([])
  pied                   String?
  plateau                String?
  profondeur             String?
  gammeRef               Gamme?          @relation(fields: [gammeId], references: [id])
  marque                 Marque          @relation(fields: [marqueId], references: [id])
  vitrine                ProduitVitrine? @relation(fields: [vitrineId], references: [id])
  variantes              Variante[]

  @@index([marqueId])
  @@index([gammeId])
  @@index([categorie])
  @@index([sousCategorie])
  @@index([hauteur])
  @@index([longueur])
  @@index([vitrineId])
}

model Variante {
  codeArticle     String  @id
  codeRacine      String
  finition        String?
  ean             String?
  poids           Float?
  prixPublicHT    Float
  ecoContribution Float   @default(0)
  prixVenteHT     Float?
  prixVerrouille  Boolean @default(false)
  prixAchatHT     Float?
  produit         Produit @relation(fields: [codeRacine], references: [codeRacine], onDelete: Cascade)

  @@index([codeRacine])
}

model Reglages {
  id             Int      @id @default(1)
  tva            Float    @default(0.20)
  remiseGlobale  Float    @default(0.20)
  updatedAt      DateTime @updatedAt
  adresse        String?
  bandeauActif   Boolean  @default(false)
  bandeauTexte   String?
  delaiLivraison String?
  email          String?
  facebook       String?
  francoPort     Float?
  horaires       String?
  instagram      String?
  linkedin       String?
  telephone      String?
  zoneLivraison  String?
  margeGlobale   Float    @default(0.30)
}

model Realisation {
  id        String   @id @default(cuid())
  titre     String
  client    String?
  secteur   String?
  surface   String?
  imageUrl  String?
  slug      String   @unique
  publie    Boolean  @default(false)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  titre     String
  slug      String   @unique
  extrait   String?
  contenu   String   @default("")
  imageUrl  String?
  categorie String?
  auteur    String?
  publie    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publie])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Promotion {
  id         String             @id @default(cuid())
  nom        String
  typeRemise String             @default("pourcentage")
  valeur     Float
  dateDebut  DateTime?
  dateFin    DateTime?
  actif      Boolean            @default(true)
  categories String[]           @default([])
  createdAt  DateTime           @default(now())
  produits   PromotionProduit[]
}

model PromotionProduit {
  promotionId String
  codeRacine  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, codeRacine])
  @@index([codeRacine])
}

model Commande {
  id              String          @id @default(cuid())
  numero          String          @unique
  statut          String          @default("en_attente")
  email           String
  telephone       String?
  prenom          String
  nom             String
  societe         String?
  adresse         String
  complement      String?
  codePostal      String
  ville           String
  pays            String          @default("France")
  totalHT         Float
  totalTVA        Float
  totalTTC        Float
  stripeSessionId String?
  stripePaymentId String?
  paye            Boolean         @default(false)
  userId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lignes          LigneCommande[]

  @@index([email])
  @@index([statut])
}

model LigneCommande {
  id          String   @id @default(cuid())
  commandeId  String
  codeRacine  String
  designation String
  marque      String?
  finition    String?
  prixHT      Float
  quantite    Int
  imageUrl    String?
  commande    Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
}

model Favori {
  id         String   @id @default(cuid())
  userId     String
  codeRacine String
  createdAt  DateTime @default(now())

  @@unique([userId, codeRacine])
  @@index([userId])
}

model ProduitVitrine {
  id                  String           @id
  nom                 String
  slug                String
  descriptif          String?
  imageUrl            String?
  images              String[]         @default([])
  ordre               Int              @default(0)
  publie              Boolean          @default(true)
  gammeId             String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  venteSurDevis       Boolean          @default(true)
  prixAPartir         Float?
  sectionsDevis       Json?
  optionsInformatives Json?
  axesDeclinaisons    Json?
  declinaisons        Json?
  groupesFinition     GroupeFinition[]
  produits            Produit[]
  gamme               Gamme            @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  categories          Categorie[]      @relation("VitrineCategories")
  sousCategories      SousCategorie[]  @relation("VitrineSousCategories")

  @@unique([gammeId, slug])
  @@index([gammeId])
}

model SousCategorie {
  id          String           @id
  nom         String
  slug        String
  ordre       Int              @default(0)
  categorieId String
  createdAt   DateTime         @default(now())
  categorie   Categorie        @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  vitrines    ProduitVitrine[] @relation("VitrineSousCategories")

  @@unique([categorieId, slug])
  @@index([categorieId])
}
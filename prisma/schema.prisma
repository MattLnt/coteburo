generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marque {
  id        String    @id @default(cuid())
  nom       String    @unique
  slug      String    @unique
  logoUrl   String?
  remise    Float     @default(0)   // 0.20 = -20% sur le tarif public
  actif     Boolean   @default(true)
  produits  Produit[]
  createdAt DateTime  @default(now())
}

model Produit {
  codeRacine             String     @id
  marque                 Marque     @relation(fields: [marqueId], references: [id])
  marqueId               String
  gamme                  String
  designation            String
  slug                   String?    @unique
  descriptionWeb         String?
  categorie              String?    // catégorie principale (accueil, bureaux, tables, sieges, rangements, acoustique)
  sousCategorie          String?    // sous-catégorie (bureaux-direction, armoires, etc.)
  imageUrl               String?                    // image principale (= images[0])
  images                 String[]   @default([])    // galerie d'images (URLs Cloudinary)
  prixPublicHT           Float                      // tarif public catalogue (référence fournisseur)
  prixAchatHT            Float?                     // prix d'achat Côté BURO (prix commerçant)
  prixVenteHT            Float?                     // prix de revente affiché sur le site
  prixVarieSelonFinition Boolean    @default(false)
  prixVerrouille         Boolean    @default(false)
  publie                 Boolean    @default(false)
  bestSeller             Boolean    @default(false)
  enAvant                Boolean    @default(false)
  variantes              Variante[]
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([marqueId])
  @@index([categorie])
  @@index([sousCategorie])
}

model Variante {
  codeArticle     String   @id
  produit         Produit  @relation(fields: [codeRacine], references: [codeRacine], onDelete: Cascade)
  codeRacine      String
  finition        String?
  ean             String?
  poids           Float?
  prixPublicHT    Float
  prixAchatHT     Float?                          // prix d'achat fournisseur de la variante
  ecoContribution Float    @default(0)
  prixVenteHT     Float?
  prixVerrouille  Boolean  @default(false)

  @@index([codeRacine])
}

model Reglages {
  id            Int      @id @default(1)
  tva           Float    @default(0.20)
  remiseGlobale Float    @default(0.20)
  telephone     String?
  email         String?
  adresse       String?
  horaires      String?
  zoneLivraison String?
  delaiLivraison String?
  francoPort    Float?
  bandeauActif  Boolean  @default(false)
  bandeauTexte  String?
  instagram     String?
  facebook      String?
  linkedin      String?
  updatedAt     DateTime @updatedAt
}

model Realisation {
  id        String   @id @default(cuid())
  titre     String
  client    String?
  secteur   String?
  surface   String?
  imageUrl  String?
  slug      String   @unique
  publie    Boolean  @default(false)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Promotion {
  id         String              @id @default(cuid())
  nom        String
  typeRemise String              @default("pourcentage")
  valeur     Float
  dateDebut  DateTime?
  dateFin    DateTime?
  actif      Boolean             @default(true)
  categories String[]            @default([])
  produits   PromotionProduit[]
  createdAt  DateTime            @default(now())
}

model PromotionProduit {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  codeRacine  String

  @@id([promotionId, codeRacine])
  @@index([codeRacine])
}
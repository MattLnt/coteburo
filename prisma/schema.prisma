generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marque {
  id         String      @id @default(cuid())
  nom        String      @unique
  slug       String      @unique
  remise     Float       @default(0)
  actif      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  logoUrl    String?
  categories Categorie[]
  gammes     Gamme[]
  produits   Produit[]
}

model Categorie {
  id             String           @id @default(cuid())
  nom            String
  slug           String
  ordre          Int              @default(0)
  marqueId       String
  createdAt      DateTime         @default(now())
  margePct       Float?
  icone          String?
  estOption      Boolean          @default(false)
  marque         Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  sousCategories SousCategorie[]
  gammes         Gamme[]          @relation("GammeCategories")
  vitrines       ProduitVitrine[] @relation("VitrineCategories")

  @@unique([marqueId, slug])
  @@index([marqueId])
}

model Gamme {
  id              String           @id @default(cuid())
  nom             String
  slug            String           @unique
  descriptif      String?
  descriptionTech String?
  imageUrl        String?
  images          String[]         @default([])
  marqueId        String
  publie          Boolean          @default(false)
  bestSeller      Boolean          @default(false)
  enAvant         Boolean          @default(false)
  ordre           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  venteSurDevis   Boolean          @default(false)
  marque          Marque           @relation(fields: [marqueId], references: [id], onDelete: Cascade)
  groupesFinition GroupeFinition[]
  produits        Produit[]
  vitrines        ProduitVitrine[]
  categories      Categorie[]      @relation("GammeCategories")

  @@index([marqueId])
}

model GroupeFinition {
  id        String          @id @default(cuid())
  nom       String
  ordre     Int             @default(0)
  gammeId   String?
  vitrineId String?
  finitions Finition[]
  gamme     Gamme?          @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  vitrine   ProduitVitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@index([gammeId])
  @@index([vitrineId])
}

model Finition {
  id          String         @id @default(cuid())
  nom         String
  imageUrl    String?
  couleur     String?
  paletteNom  String?
  ordre       Int            @default(0)
  groupeId    String
  groupe   GroupeFinition @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@index([groupeId])
}

model Produit {
  codeRacine             String          @id
  marqueId               String
  gamme                  String
  designation            String
  slug                   String?         @unique
  descriptionWeb         String?
  categorie              String?
  imageUrl               String?
  prixPublicHT           Float
  prixVenteHT            Float?
  prixVarieSelonFinition Boolean         @default(false)
  prixVerrouille         Boolean         @default(false)
  publie                 Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  prixAchatHT            Float?
  images                 String[]        @default([])
  bestSeller             Boolean         @default(false)
  enAvant                Boolean         @default(false)
  sousCategorie          String?
  gammeId                String?
  vitrineId              String?
  hauteur                Int?
  longueur               Int?
  options                String[]        @default([])
  pied                   String?
  plateau                String?
  profondeur             String?
  gammeRef               Gamme?          @relation(fields: [gammeId], references: [id])
  marque                 Marque          @relation(fields: [marqueId], references: [id])
  vitrine                ProduitVitrine? @relation(fields: [vitrineId], references: [id])
  variantes              Variante[]

  @@index([marqueId])
  @@index([gammeId])
  @@index([categorie])
  @@index([sousCategorie])
  @@index([hauteur])
  @@index([longueur])
  @@index([vitrineId])
}

model Variante {
  codeArticle     String  @id
  codeRacine      String
  finition        String?
  ean             String?
  poids           Float?
  prixPublicHT    Float
  ecoContribution Float   @default(0)
  prixVenteHT     Float?
  prixVerrouille  Boolean @default(false)
  prixAchatHT     Float?
  produit         Produit @relation(fields: [codeRacine], references: [codeRacine], onDelete: Cascade)

  @@index([codeRacine])
}

model Reglages {
  id                     Int      @id @default(1)
  tva                    Float    @default(0.20)
  remiseGlobale          Float    @default(0.20)
  updatedAt              DateTime @updatedAt
  adresse                String?
  bandeauActif           Boolean  @default(false)
  bandeauTexte           String?
  delaiLivraison         String?
  email                  String?
  facebook               String?
  francoPort             Float?
  horaires               String?
  instagram              String?
  linkedin               String?
  telephone              String?
  zoneLivraison          String?
  margeGlobale           Float    @default(0.30)
  seuilLivraisonGratuite Float    @default(500)
  fraisLivraison         Float    @default(59)
}

model PalierInstallation {
  id        String   @id @default(cuid())
  seuilMax  Float
  prix      Float
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model Realisation {
  id             String           @id @default(cuid())
  titre          String
  client         String?
  secteur        String?
  surface        String?
  imageUrl       String?
  slug           String           @unique
  publie         Boolean          @default(false)
  ordre          Int              @default(0)
  createdAt      DateTime         @default(now())
  recit          String?
  citationTexte  String?
  citationAuteur String?
  citationPoste  String?
  galerie        String[]         @default([])
  avantImageUrl  String?
  apresImageUrl  String?
  carnetChantier Json?
  produitsLies   ProduitVitrine[] @relation("RealisationProduits")
}

model Article {
  id        String   @id @default(cuid())
  titre     String
  slug      String   @unique
  extrait   String?
  contenu   String   @default("")
  imageUrl  String?
  categorie String?
  auteur    String?
  publie    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publie])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Promotion {
  id         String             @id @default(cuid())
  nom        String
  typeRemise String             @default("pourcentage")
  valeur     Float
  dateDebut  DateTime?
  dateFin    DateTime?
  actif      Boolean            @default(true)
  categories String[]           @default([])
  createdAt  DateTime           @default(now())
  produits   PromotionProduit[]
}

model PromotionProduit {
  promotionId String
  codeRacine  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, codeRacine])
  @@index([codeRacine])
}

model Commande {
  id                String          @id @default(cuid())
  numero            String          @unique
  statut            String          @default("en_attente")
  email             String
  telephone         String?
  prenom            String
  nom               String
  societe           String?
  adresse           String
  complement        String?
  codePostal        String
  ville             String
  pays              String          @default("France")
  totalHT           Float
  totalTVA          Float
  totalTTC          Float
  fraisLivraison    Float           @default(0)
  fraisInstallation Float           @default(0)
  avecInstallation  Boolean         @default(false)
  stripeSessionId   String?
  stripePaymentId   String?
  paye              Boolean         @default(false)
  userId            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lignes            LigneCommande[]

  @@index([email])
  @@index([statut])
}

model LigneCommande {
  id                   String   @id @default(cuid())
  commandeId           String
  codeRacine           String?
  designation          String
  marque               String?
  finition             String?
  prixHT               Float
  quantite             Int
  imageUrl             String?
  referenceFournisseur String?
  commande             Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
}

model Favori {
  id         String          @id @default(cuid())
  userId     String
  codeRacine String?
  vitrineId  String?
  createdAt  DateTime        @default(now())
  vitrine    ProduitVitrine? @relation(fields: [vitrineId], references: [id], onDelete: Cascade)

  @@unique([userId, codeRacine])
  @@unique([userId, vitrineId])
  @@index([userId])
}

model ProduitVitrine {
  id                        String           @id @default(cuid())
  nom                       String
  slug                      String
  descriptif                String?
  imageUrl                  String?
  images                    String[]         @default([])
  ordre                     Int              @default(0)
  publie                    Boolean          @default(true)
  gammeId                   String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  venteSurDevis             Boolean          @default(true)
  bestSeller                Boolean          @default(false)
  promoPct                  Float?
  promoDebut                DateTime?
  promoFin                  DateTime?
  prixAPartir               Float?
  largeurMin                Int?
  largeurMax                Int?
  hauteurMin                Int?
  hauteurMax                Int?
  profondeurMin             Int?
  profondeurMax             Int?
  sansDeclinaisons          Boolean          @default(false)
  prixUnitaireTarifHT       Float?
  prixUnitaireHT            Float?
  prixUnitaireVerrouille    Boolean          @default(false)
  referenceUnitaire         String?
  optionsAdditionnelles     Json?
  sectionsDevis             Json?
  optionsInformatives       Json?
  axesDeclinaisons          Json?
  declinaisons              Json?
  categoriePrincipaleId     String?
  sousCategoriePrincipaleId String?
  groupesFinition           GroupeFinition[]
  produits                  Produit[]
  favoris                   Favori[]
  realisations              Realisation[]    @relation("RealisationProduits")
  gamme                     Gamme            @relation(fields: [gammeId], references: [id], onDelete: Cascade)
  categories                Categorie[]      @relation("VitrineCategories")
  sousCategories            SousCategorie[]  @relation("VitrineSousCategories")
  optionsLiees              ProduitVitrine[] @relation("ProduitOptions")
  optionPour                ProduitVitrine[] @relation("ProduitOptions")

  @@unique([gammeId, slug])
  @@index([gammeId])
  @@index([largeurMin])
  @@index([hauteurMin])
  @@index([profondeurMin])
}

model SousCategorie {
  id          String           @id
  nom         String
  slug        String
  ordre       Int              @default(0)
  categorieId String
  createdAt   DateTime         @default(now())
  categorie   Categorie        @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  vitrines    ProduitVitrine[] @relation("VitrineSousCategories")

  @@unique([categorieId, slug])
  @@index([categorieId])
}

// ─────────────────────────────────────────────────────────────
// Bibliothèque de finitions partagée (référentiel réutilisable)
// PaletteFinition = un regroupement (ex. "Palette bois Buronomic")
// FinitionModele  = une finition définie une seule fois (couleur + swatch)
// ─────────────────────────────────────────────────────────────
model PaletteFinition {
  id        String           @id @default(cuid())
  nom       String
  marque    String?
  ordre     Int              @default(0)
  createdAt DateTime         @default(now())
  finitions FinitionModele[]
}

model FinitionModele {
  id        String           @id @default(cuid())
  nom       String
  couleur   String?
  imageUrl  String?
  ordre     Int              @default(0)
  paletteId String?
  palette   PaletteFinition? @relation(fields: [paletteId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([paletteId])
}
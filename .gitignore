# Tarif OfficePro : source fournisseur et extraction regenerable.
TARIF_GENERAL_COMPLET_OFFICEPRO_SEATING_2026.pdf
prisma/officepro-tarif.json
prisma/officepro-fiches.json
prisma/officepro-images-attribution.json
officepro-fiches-a-rediger.json
officepro-descriptions.json

# Catalogues et tarifs fournisseurs 2026 : sources PDF de 155 Mo, dont une
# de 92 Mo. On garde les extractions (JSON, xlsx), qui sont ce dont les
# scripts ont besoin au quotidien, et pas les binaires — même règle que
# pour le tarif OfficePro ci-dessus.
catalogue-2026/*.pdf

# Cache Python des parsers du catalogue.
__pycache__/
*.pyc

# Profil du navigateur des captures pCon : un cache local, reconstruit
# tout seul au premier lancement.
.pcon-cache/

# Fichiers de travail des analyses de médias : régénérables par
# analyse-medias-sokoa-officepro.mjs.
_troncs.json
troncs-4-a-trancher.md
